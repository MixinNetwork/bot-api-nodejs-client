{
  "name": "@mixin.dev/mixin-node-sdk",
  "version": "7.5.6",
  "license": "MIT",
  "description": "Mixin SDK for Node.js and Javascript",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mixin-node-sdk.esm.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./blaze": {
      "types": "./dist/blaze/index.d.ts",
      "import": "./dist/blaze/index.mjs",
      "require": "./dist/blaze/index.js",
      "default": "./dist/blaze/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MixinNetwork/bot-api-nodejs-client.git"
  },
  "bugs": {
    "url": "https://github.com/MixinNetwork/bot-api-nodejs-client/issues"
  },
  "homepage": "https://github.com/MixinNetwork/bot-api-nodejs-client#readme",
  "keywords": [
    "mixin",
    "node",
    "blockchain",
    "crypto",
    "js"
  ],
  "scripts": {
    "start": "bunchee --watch",
    "build": "rm -rf dist && bunchee",
    "build:umd": "bunchee --runtime browser --format umd --output dist/mixin-node-sdk.umd.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**' && prettier --check .",
    "format": "prettier --write .",
    "prepare": "npm run build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "author": "contact@mixin.one",
  "module": "dist/mixin-node-sdk.esm.mjs",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "80 KB"
    },
    {
      "path": "dist/mixin-node-sdk.esm.mjs",
      "limit": "65 KB"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/esbuild": "^12.1.0",
    "@size-limit/esbuild-why": "^12.1.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/md5": "^2.3.6",
    "@types/node": "^25.9.5",
    "@types/node-forge": "^1.3.14",
    "@types/pako": "^2.0.4",
    "@types/serialize-javascript": "^5.0.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "buffer": "^6.0.3",
    "bunchee": "^6.12.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "node-forge": "^1.4.0",
    "prettier": "^3.9.6",
    "size-limit": "^12.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "axios": "^1.20.0",
    "axios-retry": "4.5.0",
    "bignumber.js": "^11.1.5",
    "bs58": "^6.0.0",
    "int64-buffer": "^1.1.2",
    "is-retry-allowed": "^3.0.0",
    "md5": "^2.3.0",
    "nano-seconds": "^1.2.2",
    "pako": "^2.2.0",
    "serialize-javascript": "^7.1.1",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "directories": {
    "example": "example",
    "test": "test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
